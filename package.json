{
  "name": "mk4",
  "displayName": "mk4",
  "description": "Markdown but a little bit better !",
  "publisher": "rob1forest",
  "version": "1.3.1",
  "icon": "public/favicon-128x128.ico",
  "engines": {
    "vscode": "^1.125.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forestierr/mk4"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mk4.showPreview",
        "title": "mk4: Afficher l'aperçu",
        "category": "Markdown",
        "icon": {
          "light": "./resources/icons/preview-light.svg",
          "dark": "./resources/icons/preview-dark.svg"
        }
      },
      {
        "command": "mk4.exportPdf",
        "title": "mk4: Exporter en PDF",
        "category": "Markdown",
        "icon": {
          "light": "./resources/icons/pdf-light.svg",
          "dark": "./resources/icons/pdf-dark.svg"
        }
      },
      {
        "command": "mk4.exportTypst",
        "title": "mk4: Exporter le code Typst",
        "category": "Markdown",
        "icon": {
          "light": "./resources/icons/typ-light.svg",
          "dark": "./resources/icons/typ-dark.svg"
        }
      },
      {
        "command": "mk4.showMarkdownPreview",
        "title": "mk4: Aperçu Markdown Brut",
        "category": "Markdown",
        "icon": {
          "light": "./resources/icons/md-light.svg",
          "dark": "./resources/icons/md-dark.svg"
        }
      },
      {
        "command": "mk4.selectTheme",
        "title": "mk4: Changer de thème",
        "category": "Markdown",
        "icon": "$(paintcan)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mk4.showPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "mk4.showMarkdownPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "mk4.exportPdf",
          "when": "resourceLangId == markdown",
          "group": "navigation@3"
        },
        {
          "command": "mk4.exportTypst",
          "when": "resourceLangId == markdown",
          "group": "navigation@4"
        }
      ]
    },
    "grammars": [
      {
        "path": "./syntaxes/mk4-annotations.json",
        "scopeName": "markdown.mk4.injection",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./.vscode/mk4.code-snippets"
      }
    ],
    "configuration": [
      {
        "title": "MK4 — Aperçu",
        "properties": {
          "mk4.preview.debounceMs": {
            "type": "number",
            "default": 300,
            "minimum": 100,
            "maximum": 2000,
            "description": "Délai (en ms) avant la mise à jour de la prévisualisation après une frappe. Augmentez cette valeur sur les machines lentes."
          },
          "mk4.preview.enableScrollSync": {
            "type": "boolean",
            "default": true,
            "description": "Synchronise le défilement entre l'éditeur et la prévisualisation."
          },
          "mk4.editor.enableCodeLens": {
            "type": "boolean",
            "default": false,
            "description": "Affiche les boutons d'action MK4 (CodeLens) en en-tête des fichiers Markdown."
          }
        }
      },
      {
        "title": "MK4 — Thème",
        "properties": {
          "mk4.typst.defaultTheme": {
            "type": "string",
            "default": "default",
            "enum": ["default", "modern", "academic"],
            "enumDescriptions": [
              "Thème propre et lisible, sans page de garde séparée.",
              "Thème moderne avec accents colorés et page de garde.",
              "Thème académique formel, inspiré LaTeX."
            ],
            "description": "Le thème Typst par défaut à utiliser pour la compilation."
          },
          "mk4.typst.customThemePath": {
            "type": "string",
            "default": "",
            "description": "Chemin absolu vers un fichier .typ personnalisé (écrase le thème par défaut)."
          }
        }
      },
      {
        "title": "MK4 — Mise en page",
        "properties": {
          "mk4.typst.lang": {
            "type": "string",
            "default": "",
            "markdownDescription": "Code de langue du document Typst (`fr`, `en`, `de`…). Laissez vide pour utiliser la langue de l'interface VS Code automatiquement."
          },
          "mk4.typst.pageMargin": {
            "type": "string",
            "default": "2.5cm",
            "markdownDescription": "Marge des pages (ex : `2.5cm`, `1in`, `20mm`). S'applique aux marges horizontales et verticales."
          },
          "mk4.typst.pageNumbering": {
            "type": "string",
            "default": "1 / 1",
            "enum": ["1 / 1", "1", "i", "none"],
            "enumDescriptions": [
              "Page X sur Y total (ex : 2 / 5)",
              "Numéro de page simple (ex : 2)",
              "Numérotation en chiffres romains (ex : ii)",
              "Pas de numérotation"
            ],
            "description": "Format de numérotation des pages dans le pied de page."
          }
        }
      },
      {
        "title": "MK4 — Typographie",
        "properties": {
          "mk4.typst.fontFamily": {
            "type": "string",
            "default": "",
            "markdownDescription": "Police principale du document (ex : `Linux Libertine`, `New Computer Modern`, `Arial`). Laissez vide pour utiliser celle du thème."
          },
          "mk4.typst.fontSize": {
            "type": "string",
            "default": "",
            "markdownDescription": "Taille de la police principale (ex : `11pt`, `12pt`, `10.5pt`). Laissez vide pour utiliser celle du thème."
          },
          "mk4.typst.syntaxHighlighting": {
            "type": "boolean",
            "default": true,
            "description": "Active la coloration syntaxique dans les blocs de code Typst."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package-build && node scripts/fetch-typst-binaries.js",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', { recursive: true, force: true }); if (fs.existsSync('out')) fs.rmSync('out', { recursive: true, force: true });\"",
    "compile": "npm run clean && tsc -p ./ && npm run esbuild",
    "watch": "npm run clean && npm run esbuild && tsc -watch -p ./",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "package-build": "npm run clean && npm run esbuild-base -- --minify",
    "fetch-binaries": "node scripts/fetch-typst-binaries.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package",
    "publish-extension": "vsce publish"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "commitlint": "^21.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "remark-footnotes": "^3.0.0",
    "remark-gfm": "^1.0.0",
    "remark-html": "^13.0.2",
    "remark-math": "^4.0.0",
    "remark-parse": "^9.0.0",
    "unified": "^9.2.2",
    "unist-util-visit": "^2.0.3"
  }
}
